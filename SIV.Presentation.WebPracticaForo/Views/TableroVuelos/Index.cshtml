@model IEnumerable<SIV.Application.DTOs.Vuelo.DatosVueloDTO>

@{
    ViewData["Title"] = "Tablero de Vuelos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Tablero de Vuelos</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Vuelo</th>
            <th>Aerolínea</th>
            <th>Origen</th>
            <th>Destino</th>
            <th>Estado</th>
            <th>Salida Programada</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var vuelo in Model)
            {
                <tr>
                    <td>@vuelo.NumeroVuelo</td>
                    <td>@vuelo.AerolineaNombre</td>
                    <td>@vuelo.AeropuertoOrigenIATA</td>
                    <td>@vuelo.AeropuertoDestinoIATA</td>
                    <td>
                        <span class="badge bg-info text-dark">@vuelo.EstadoActual</span>
                    </td>
                    <td>@vuelo.FechaSalidaProgramada.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a asp-controller="Vuelos"
                           asp-action="Details"
                           asp-route-id="@vuelo.Id"
                           class="btn btn-info">
                            Ver Detalles
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    No existen vuelos registrados en el tablero.
                </td>
            </tr>
        }
    </tbody>
</table>
