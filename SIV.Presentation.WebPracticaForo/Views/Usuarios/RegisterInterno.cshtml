@model SIV.Application.DTOs.Usuario.RegistroUsuarioInternoDTO

@{
    ViewData["Title"] = "Registrar Usuario Interno";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Registrar Usuario Interno</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="RegisterInterno" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold"></label>
                <input asp-for="Email" class="form-control" placeholder="correo@empresa.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold">Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rol" class="form-label fw-bold"></label>
                <select asp-for="Rol" class="form-select">
                    @if (ViewBag.Roles != null)
                    {
                        @foreach (var rol in ViewBag.Roles)
                        {
                            <option value="@rol">@rol</option>
                        }
                    }
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Registrar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
