@model SIV.Application.DTOs.Reportes.ReporteSeguimientoDTO

@{
    ViewData["Title"] = "Reporte de Seguimiento";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Reporte de Seguimiento</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-controller="Reportes" asp-action="Seguimiento" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label fw-bold">Desde:</label>
        <input type="datetime-local" name="FechaInicio" class="form-control" value="@Model.FechaInicio.ToString("yyyy-MM-ddTHH:mm")" />
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">Hasta:</label>
        <input type="datetime-local" name="FechaFin" class="form-control" value="@Model.FechaFin.ToString("yyyy-MM-ddTHH:mm")" />
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">
            Actualizar Reporte
        </button>
    </div>
</form>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5>Resumen</h5>
        <p>
            Desde: @Model.FechaInicio.ToString("dd/MM/yyyy hh:mm tt") <br />
            Hasta: @Model.FechaFin.ToString("dd/MM/yyyy hh:mm tt")
        </p>

        <hr />

        <div class="row">
            <div class="col-md-6">
                <h4>Seguimientos iniciados: <span class="text-success">@Model.TotalSeguimientosIniciados</span></h4>
            </div>
            <div class="col-md-6">
                <h4>Seguimientos finalizados: <span class="text-danger">@Model.TotalSeguimientosFinalizados</span></h4>
            </div>
        </div>
    </div>
</div>

<h3 class="mt-4">Vuelos más seguidos</h3>
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Vuelo</th>
            <th>Cantidad</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.VuelosMasSeguidos != null && Model.VuelosMasSeguidos.Any())
        {
            @foreach (var vuelo in Model.VuelosMasSeguidos)
            {
                <tr>
                    <td>@vuelo.NumeroVuelo</td>
                    <td>@vuelo.TotalSeguidores</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center text-muted py-3">No existen vuelos seguidos en este periodo.</td>
            </tr>
        }
    </tbody>
</table>

<h3 class="mt-4">Usuarios activos</h3>
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.UsuariosActivos != null && Model.UsuariosActivos.Any())
        {
            @foreach (var usuario in Model.UsuariosActivos)
            {
                <tr>
                    <td>@usuario.UsuarioId</td>
                    <td>@usuario.TotalSeguimientos</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center text-muted py-3">No existen usuarios activos en este periodo.</td>
            </tr>
        }
    </tbody>
</table>
