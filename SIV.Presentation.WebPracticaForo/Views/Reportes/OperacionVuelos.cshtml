@model SIV.Application.DTOs.Reportes.ReporteOperacionVuelosDTO

@{
    ViewData["Title"] = "Reporte Operación de Vuelos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Reporte Operación de Vuelos</h2>
    <div>
        <a asp-action="ExportarOperacionVuelosCsv" class="btn btn-success">
            Exportar CSV
        </a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-controller="Reportes" asp-action="OperacionVuelos" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label fw-bold">Desde:</label>
        <input type="datetime-local" name="FechaInicio" class="form-control" value="@Model.FechaInicio.ToString("yyyy-MM-ddTHH:mm")" />
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">Hasta:</label>
        <input type="datetime-local" name="FechaFin" class="form-control" value="@Model.FechaFin.ToString("yyyy-MM-ddTHH:mm")" />
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">
            Actualizar Reporte
        </button>
    </div>
</form>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5>Periodo Seleccionado</h5>
        <p>
            Desde: @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm") <br />
            Hasta: @Model.FechaFin.ToString("dd/MM/yyyy HH:mm")
        </p>

        <hr />

        <div class="row text-center">
            <div class="col-md-3">
                <h3 class="text-primary">@Model.TotalVuelosRegistrados</h3>
                <p class="text-muted">Registrados</p>
            </div>

            <div class="col-md-3">
                <h3 class="text-danger">@Model.TotalVuelosCancelados</h3>
                <p class="text-muted">Cancelados</p>
            </div>

            <div class="col-md-3">
                <h3 class="text-warning text-dark">@Model.TotalVuelosRetrasados</h3>
                <p class="text-muted">Retrasados</p>
            </div>

            <div class="col-md-3">
                <h3 class="text-success">@Model.TotalVuelosCompletados</h3>
                <p class="text-muted">Completados</p>
            </div>
        </div>
    </div>
</div>
