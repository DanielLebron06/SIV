@{
    ViewData["Title"] = "Reportes";
}


<h2>Reportes del Sistema</h2>


<div class="row mt-4">


    <div class="col-md-3">

        <div class="card">

            <div class="card-body">

                <h5>
                    Operación de vuelos
                </h5>


                <a asp-action="OperacionVuelos"
                   class="btn btn-primary">

                    Abrir

                </a>

            </div>

        </div>

    </div>




    <div class="col-md-3">

        <div class="card">

            <div class="card-body">

                <h5>
                    Auditoría
                </h5>


                <a asp-action="Auditoria"
