@model IEnumerable<SIV.Application.DTOs.Aerolinea.AerolineaDTO>


@{
    ViewData["Title"] = "Aerolíneas";
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Aerolíneas</h2>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">

    <div class="card-header">
        Registrar Aerolínea
    </div>


    <div class="card-body">


        <form asp-action="RegistrarAerolinea" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <!-- Cambiado name="Nombre" por name="datos.Nombre" -->
                <input name="datos.Nombre" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Código IATA</label>
                <!-- Cambiado name="CodigoIATA" por name="datos.CodigoIATA" -->
                <input name="datos.CodigoIATA" class="form-control" maxlength="3" required />
            </div>

            <button type="submit" class="btn btn-success">Registrar</button>
        </form>



    </div>

</div>


<table class="table table-striped">


    <thead>

        <tr>

            <th>
                Nombre
            </th>


            <th>
                Estado
            </th>


            <th>
                Acciones
            </th>


        </tr>

    </thead>



    <tbody>


        @foreach (var item in Model)
        {

            <tr>


                <td>
                    @item.Nombre
                </td>



                <td>

                    @if (item.Activa)
                    {
                        <span class="badge bg-success">
                            Activa
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inactiva
                        </span>
                    }

                </td>




                <td>


                    @if (item.Activa)
                    {

                        <form asp-action="DesactivarAerolinea"
                              method="post">
                              @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />


                            <button type="submit"
                                    class="btn btn-danger btn-sm">

                                Desactivar

                            </button>


                        </form>

                    }


                </td>



            </tr>

        }


    </tbody>


</table>