@model FidsViewModel
@{
    ViewData["Title"] = "Salidas";
}

<div class="fids-tablero">
    <div class="fids-titulo-panel">
        <h1 class="fids-titulo">SALIDAS</h1>
        <span class="fids-panel-info">@(Model.Aeropuerto ?? "TODOS LOS AEROPUERTOS")</span>
    </div>
    <div class="fids-contenido" id="fidsContenido">
        @await Html.PartialAsync("_TablaFidsPartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        window.FidsConfig = {
            tipo: "salidas",
            aeropuerto: "@(Model.Aeropuerto ?? string.Empty)",
            urlRefresco: "@Url.Action("TablaPartial", "Tablero", new { aeropuerto = Model.Aeropuerto, esSalida = true })"
        };
    </script>
}
