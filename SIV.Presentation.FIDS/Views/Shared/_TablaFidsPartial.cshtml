@model FidsViewModel
@using SIV.Presentation.FIDS.Services

@if (!Model.ApiDisponible)
{
    <div class="fids-no-data">Conectando con el sistema de información de vuelos...</div>
}
else if (!Model.Vuelos.Any())
{
    <div class="fids-no-data">No hay vuelos para mostrar en este momento.</div>
}
else
{
    var esSalidas = Model.TipoPantalla == TipoPantallaFids.Salidas;
    var esLlegadas = Model.TipoPantalla == TipoPantallaFids.Llegadas;
    var esGeneral = Model.TipoPantalla == TipoPantallaFids.General;

    <table class="fids-table">
        <thead>
            <tr>
                <th>Vuelo</th>
                <th>Aerolínea</th>
                <th>Origen</th>
                <th>Destino</th>
                <th>Hora</th>
                <th>Hora Est.</th>
                @if (esSalidas || esGeneral)
                {
                    <th>Puerta</th>
                }
                @if (esLlegadas || esGeneral)
                {
                    <th>Terminal</th>
                    <th>Banda</th>
                }
                <th>Estado</th>
            </tr>
        </thead>
        <tbody id="fidsTbody">
            @for (var i = 0; i < Model.Vuelos.Count; i++)
            {
                var vuelo = Model.Vuelos[i];
                var mostrarPuerta = esSalidas || (esGeneral && vuelo.EsSalida);
                var mostrarBandaTerminal = esLlegadas || (esGeneral && !vuelo.EsSalida);

                <tr class="fids-fila" data-fila="@i">
                    <td class="fids-vuelo">@vuelo.NumeroVuelo</td>
                    <td class="fids-aerolinea">@vuelo.AerolineaNombre</td>
                    <td class="fids-iata">@vuelo.OrigenIATA</td>
                    <td class="fids-iata">@vuelo.DestinoIATA</td>
                    <td class="fids-hora">@vuelo.HoraProgramadaTexto</td>
                    <td class="fids-hora">@vuelo.HoraEstimadaTexto</td>
                    @if (esSalidas || esGeneral)
                    {
                        <td class="fids-puerta">@(mostrarPuerta ? vuelo.PuertaEmbarque : "-")</td>
                    }
                    @if (esLlegadas || esGeneral)
                    {
                        <td class="fids-terminal">@(mostrarBandaTerminal ? vuelo.Terminal : "-")</td>
                        <td class="fids-banda">@(mostrarBandaTerminal ? vuelo.BandaEquipaje : "-")</td>
                    }
                    <td><span class="@vuelo.BadgeClass">@vuelo.EstadoTexto</span></td>
                </tr>
            }
        </tbody>
    </table>
    <input type="hidden" id="fidsTotalPaginas" value="@Model.TotalPaginas" />
}
