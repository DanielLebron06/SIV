@model IEnumerable<SIV.Application.DTOs.Auditoria.LogAuditoriaDTO>

@{
    ViewData["Title"] = "Log de Auditoría";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Log de Auditoría</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Actor</th>
            <th>Módulo</th>
            <th>Acción</th>
            <th>Resultado</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Actor</td>
                    <td>@item.Modulo</td>
                    <td>@item.TipoAccion</td>
                    <td>@item.Resultado</td>
                    <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    No existen registros de auditoría.
                </td>
            </tr>
        }
    </tbody>
</table>
