@model SIV.Application.DTOs.Vuelo.DatosVueloDTO

@{
    ViewData["Title"] = "Registrar Vuelo";
}

<h1>Registrar Nuevo Vuelo</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Número de Vuelo -->
            <div class="mb-3">
                <label asp-for="NumeroVuelo" class="form-label font-weight-bold">Número de Vuelo</label>
                <input asp-for="NumeroVuelo" class="form-control" placeholder="Ej: AA-102" />
                <span asp-validation-for="NumeroVuelo" class="text-danger"></span>
            </div>

            <!-- Desplegable Aerolínea -->
            <div class="mb-3">
                <label asp-for="AerolineaId" class="form-label font-weight-bold">Aerolínea</label>
                <select asp-for="AerolineaId" class="form-select" asp-items="ViewBag.Aerolineas">
                    <option value="">-- Seleccione una Aerolínea --</option>
                </select>
                <span asp-validation-for="AerolineaId" class="text-danger"></span>
            </div>

            <!-- Desplegable Aeropuerto Origen -->
            <div class="mb-3">
                <label asp-for="AeropuertoOrigenId" class="form-label font-weight-bold">Aeropuerto de Origen</label>
                <select asp-for="AeropuertoOrigenId" class="form-select" asp-items="ViewBag.Aeropuertos">
                    <option value="">-- Seleccione Origen --</option>
                </select>
                <span asp-validation-for="AeropuertoOrigenId" class="text-danger"></span>
            </div>

            <!-- Desplegable Aeropuerto Destino -->
            <div class="mb-3">
                <label asp-for="AeropuertoDestinoId" class="form-label font-weight-bold">Aeropuerto de Destino</label>
                <select asp-for="AeropuertoDestinoId" class="form-select" asp-items="ViewBag.Aeropuertos">
                    <option value="">-- Seleccione Destino --</option>
                </select>
                <span asp-validation-for="AeropuertoDestinoId" class="text-danger"></span>
            </div>

            <!-- Fechas -->
            <div class="mb-3">
                <label asp-for="FechaSalidaProgramada" class="form-label font-weight-bold">Fecha y Hora de Salida</label>
                <input asp-for="FechaSalidaProgramada" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaSalidaProgramada" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaLlegadaProgramada" class="form-label font-weight-bold">Fecha y Hora de Llegada</label>
                <input asp-for="FechaLlegadaProgramada" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaLlegadaProgramada" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-success">Guardar Vuelo</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>