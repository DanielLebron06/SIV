@model IEnumerable<SIV.Application.DTOs.Vuelo.DatosVueloDTO>

@{
    ViewData["Title"] = "Listado de Vuelos";
    var filtros = ViewBag.Filtros as SIV.Domain.Common.FiltrosVuelos ?? new SIV.Domain.Common.FiltrosVuelos();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Listado de Vuelos</h1>
    <a asp-action="Create" class="btn btn-success">+ Registrar Nuevo Vuelo</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">@ViewBag.Message</div>
}

<!-- SECCIÓN DE FILTRADO -->
<div class="card my-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Filtrar Búsqueda</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-4">
                <label class="form-label font-weight-bold">Fecha de Vuelo</label>
                <input type="date" name="Fecha" class="form-control"
                       value="@(filtros?.Fecha != null ? ((DateTimeOffset)filtros.Fecha).ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-md-4">
                <label class="form-label font-weight-bold">Estado</label>
                <select name="Estado" class="form-select" asp-items="Html.GetEnumSelectList<SIV.Domain.Emuns.EstadoVuelo>()">
                    <option value="">-- Todos --</option>
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Número de Vuelo</th>
            <th>Salida Programada</th>
            <th>Llegada Programada</th>
            <th>Estado</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var vuelo in Model)
            {
                <tr>
                    <td>@vuelo.NumeroVuelo</td>
                    <td>@vuelo.FechaSalidaProgramada.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@vuelo.FechaLlegadaProgramada.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge bg-info text-dark">@vuelo.EstadoActual</span></td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@vuelo.Id" class="btn btn-sm btn-outline-info">Ver Detalle</a>
                        <a asp-action="Edit" asp-route-id="@vuelo.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No hay vuelos disponibles con los criterios seleccionados.</td>
            </tr>
        }
    </tbody>
</table>