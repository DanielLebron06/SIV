@model SIV.Application.DTOs.Vuelo.DatosVueloDTO

@{
    ViewData["Title"] = "Detalle del Vuelo";
    var historial = ViewBag.Historial as IEnumerable<dynamic>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Detalle del Vuelo</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            Editar
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Información General</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="fw-bold">Número de Vuelo</label>
                <div>@Model.NumeroVuelo</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="fw-bold">Estado Actual</label>
                <div>
                    <span class="badge bg-info text-dark fs-6">@Model.EstadoActual</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="fw-bold">Aerolínea</label>
                <div>@Model.AerolineaNombre</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="fw-bold">Aeropuerto de Origen</label>
                <div>@Model.AeropuertoOrigenIATA</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="fw-bold">Aeropuerto de Destino</label>
                <div>@Model.AeropuertoDestinoIATA</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="fw-bold">Salida Programada</label>
                <div>@Model.FechaSalidaProgramada.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="fw-bold">Llegada Programada</label>
                <div>@Model.FechaLlegadaProgramada.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4 border-success shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Seguimiento del Vuelo</h5>
    </div>
    <div class="card-body">
        <p class="mb-3">Reciba notificaciones cada vez que este vuelo cambie de estado.</p>
        <form asp-controller="Usuarios" asp-action="SeguirVuelo" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="vueloId" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Seguir Vuelo</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Actualizar Estado del Vuelo</h5>
    </div>
    <div class="card-body">
        <form asp-controller="VueloEstados" asp-action="Cambiar" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <select name="nuevoEstado" class="form-select">
                <option value="Embarcando">Embarcando</option>
                <option value="EnVuelo">En vuelo</option>
                <option value="Retrasado">Retrasado</option>
                <option value="Aterrizado">Aterrizado</option>
                <option value="Cancelado">Cancelado</option>
            </select>

            <button type="submit" class="btn btn-warning mt-2">
                Actualizar Estado
            </button>
        </form>

    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Historial de Estados</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Estado</th>
                    <th>Fecha del Cambio</th>
                </tr>
            </thead>
            <tbody>
                @if (historial != null && historial.Any())
                {
                    @foreach (var item in historial)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">@item.Estado</span>
                            </td>
                            <td>@item.FechaCambio</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-4">
                            Este vuelo aún no posee historial de estados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
