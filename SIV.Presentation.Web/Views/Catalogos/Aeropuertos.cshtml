@model IEnumerable<SIV.Application.DTOs.Aeropuerto.AeropuertoDTO>


@{
    ViewData["Title"] = "Aeropuertos";
}



<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>
        Aeropuertos
    </h2>


    <a asp-action="Index"
       class="btn btn-secondary">

        Volver

    </a>


</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


<div class="card mb-4">


    <div class="card-header">

        Registrar Aeropuerto

    </div>



    <div class="card-body">


        <form asp-action="RegistrarAeropuerto" method="post">
    @Html.AntiForgeryToken() 

    <div class="row">
        <div class="col-md-6 mb-3">
            <label>Nombre</label>
            <input name="datos.Nombre" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Código IATA</label>
            <input name="datos.CodigoIATA" class="form-control" maxlength="3" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Ciudad</label>
            <input name="datos.Ciudad" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>País</label>
            <input name="datos.Pais" class="form-control" required />
        </div>
    </div>

    <button type="submit" class="btn btn-success">Registrar</button>
</form>


    </div>


</div>










<table class="table table-striped">


    <thead>

        <tr>

            <th>
                Nombre
            </th>


            <th>
                Código IATA
            </th>


            <th>
                Estado
            </th>


            <th>
                Acciones
            </th>


        </tr>

    </thead>




    <tbody>


        @foreach (var item in Model)
        {


            <tr>


                <td>
                    @item.Nombre
                </td>



                <td>
                    @item.CodigoIATA
                </td>




                <td>

                    @if (item.Activo)
                    {

                        <span class="badge bg-success">
                            Activo
                        </span>

                    }
                    else
                    {

                        <span class="badge bg-secondary">
                            Inactivo
                        </span>

                    }


                </td>





                <td>


                    @if (item.Activo)
                    {


                        <form asp-action="DesactivarAeropuerto"
                              method="post">


                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />



                            <button type="submit"
                                    class="btn btn-danger btn-sm">

                                Desactivar

                            </button>


                        </form>


                    }



                </td>


            </tr>


        }



    </tbody>


</table>