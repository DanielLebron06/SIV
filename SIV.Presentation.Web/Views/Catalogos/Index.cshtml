@{
    ViewData["Title"] = "Catálogos";
}


<h2>Administración de Catálogos</h2>


<div class="row mt-4">


    <div class="col-md-4">

        <div class="card">

            <div class="card-body">

                <h4>Aerolíneas</h4>

                <p>
                    Gestionar aerolíneas registradas.
                </p>


                <a asp-action="Aerolineas"
                   class="btn btn-primary">

                    Administrar

                </a>


            </div>

        </div>

    </div>





    <div class="col-md-4">

        <div class="card">

            <div class="card-body">

                <h4>Aeropuertos</h4>

                <p>
                    Gestionar aeropuertos disponibles.
                </p>


                <a asp-action="Aeropuertos"
                   class="btn btn-primary">

                    Administrar

                </a>


            </div>

        </div>

    </div>


</div>