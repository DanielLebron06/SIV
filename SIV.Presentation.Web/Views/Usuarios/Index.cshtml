@model IEnumerable<SIV.Application.DTOs.Usuario.UsuarioInternoDTO>

@{
    ViewData["Title"] = "Usuarios Internos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Usuarios Internos</h1>

    <div>
        <a asp-action="Notificaciones"
           class="btn btn-primary me-2">
            Mis Notificaciones
        </a>

        <a asp-action="RegisterInterno"
           class="btn btn-success">
            + Registrar Usuario Interno
        </a>
    </div>
</div>

<div class="mb-3">

    <a asp-action="Index"
       asp-route-activo=""
       class="btn @(ViewBag.Activo == null ? "btn-secondary" : "btn-outline-secondary")">
        Todos
    </a>

    <a asp-action="Index"
       asp-route-activo="true"
       class="btn @(ViewBag.Activo?.ToString() == "True" ? "btn-success" : "btn-outline-success")">
        Activos
    </a>

    <a asp-action="Index"
       asp-route-activo="false"
       class="btn @(ViewBag.Activo?.ToString() == "False" ? "btn-danger" : "btn-outline-danger")">
        Inactivos
    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">
        @ViewBag.Message
    </div>
}

<table class="table table-striped table-hover align-middle">

    <thead>
        <tr>
            <th>Email</th>
            <th>Rol</th>
            <th>Estado</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Any())
        {
            foreach (var usuario in Model)
            {
                <tr>

                    <td>@usuario.Email</td>

                    <td>@usuario.Rol</td>

                    <td>

                        @if (usuario.Activo)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }

                    </td>

                    <td class="text-center">

                        @if (usuario.Activo)
                        {
                            <form asp-action="Desactivar"
                                  asp-route-id="@usuario.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('¿Desea desactivar este usuario?');">

                                    Desactivar

                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar"
                                  asp-route-id="@usuario.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-success"
                                        onclick="return confirm('¿Desea activar este usuario?');">

                                    Activar

                                </button>

                            </form>
                        }

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4"
                    class="text-center text-muted">

                    No existen usuarios para este filtro.

                </td>
            </tr>
        }

    </tbody>

</table>