@model IEnumerable<SIV.Presentation.WebUser.Models.VueloViewModel>

@{
    ViewData["Title"] = "Consulta de Vuelos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tablero de Vuelos</h2>
    <a asp-action="Index" class="btn btn-secondary btn-sm">🔄 Actualizar</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nº Vuelo</th>
            <th>Aerolínea</th>
            <th>Origen → Destino</th>
            <th>Salida Programada</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No hay vuelos disponibles actualmente.</td>
            </tr>
        }
        else
        {
            @foreach (var vuelo in Model)
            {
                <tr>
                    <td class="fw-bold">@vuelo.NumeroVuelo</td>
                    <td>@vuelo.AerolineaNombre</td>
                    <td>@vuelo.AeropuertoOrigenIATA ➔ @vuelo.AeropuertoDestinoIATA</td>
                    <td>@vuelo.FechaSalidaProgramada.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge bg-primary">@vuelo.EstadoTexto</span></td>
                    <td>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="Seguir" method="post" class="d-inline">
                                <input type="hidden" name="vueloId" value="@vuelo.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">➕ Seguir</button>
                            </form>
                        }
                        else
                        {
                            <small class="text-muted"><a asp-action="Login">Inicia sesión</a> para seguir</small>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>