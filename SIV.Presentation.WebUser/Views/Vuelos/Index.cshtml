@model FiltrosVuelosViewModel
@{
    ViewData["Title"] = "Consultar Vuelos";
}

<div class="mb-4">
    <h1 class="h3">Consultar Vuelos</h1>
    <p class="text-muted">Consulta los vuelos de llegada y salida con su estado actualizado.</p>
</div>

<form method="get" asp-action="Index" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4 col-12">
                <label class="form-label" asp-for="AerolineaId">Aerolínea</label>
                <select class="form-select" asp-for="AerolineaId" asp-items="Model.OpcionesAerolineas">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-4 col-12">
                <label class="form-label" asp-for="AeropuertoOrigenId">Aeropuerto de Origen</label>
                <select class="form-select" asp-for="AeropuertoOrigenId" asp-items="Model.OpcionesAeropuertos">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-4 col-12">
                <label class="form-label" asp-for="AeropuertoDestinoId">Aeropuerto de Destino</label>
                <select class="form-select" asp-for="AeropuertoDestinoId" asp-items="Model.OpcionesAeropuertos">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-4 col-6">
                <label class="form-label" asp-for="Fecha">Fecha</label>
                <input class="form-control" type="date" asp-for="Fecha" asp-format="{0:yyyy-MM-dd}" />
            </div>
            <div class="col-md-4 col-6">
                <label class="form-label" asp-for="Estado">Estado</label>
                <select class="form-select" asp-for="Estado" asp-items="Model.OpcionesEstados">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-4 col-12 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
        </div>
    </div>
</form>

@await Html.PartialAsync("_TablaVuelosPartial", Model.Vuelos)
