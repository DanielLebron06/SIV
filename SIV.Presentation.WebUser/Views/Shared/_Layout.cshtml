<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIV Aeropuerto</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SIV Aeropuerto</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vuelos" asp-action="Index">Consultar Vuelos</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cuenta" asp-action="MisSeguimientos">Mis Seguimientos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cuenta" asp-action="Notificaciones">Notificaciones</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-light small">@User.Identity.Name</span>
                            <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar Sesión</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Cuenta" asp-action="Login" class="btn btn-outline-light btn-sm">Iniciar Sesión</a>
                            <a asp-controller="Cuenta" asp-action="Registro" class="btn btn-light btn-sm">Registrarse</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4 mb-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="border-top py-3 text-center text-muted">
        <div class="container">
            SIV Aeropuerto - Sistema de Información de Vuelos
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
