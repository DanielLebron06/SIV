@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="display-6 text-danger">@Model.StatusCode - Error</h1>
    <p class="lead">@Model.Mensaje</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">ID de solicitud: @Model.RequestId</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al inicio</a>
</div>
